# Server Configuration
PORT=3000

# Database Configuration (Pilih salah satu: Supabase PostgreSQL atau SQLite Lokal)
# Opsi 1: Supabase (Recommended)
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI (Mode Transaction / Session)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Opsi 2: SQLite Lokal (Development offline)
# DATABASE_URL="file:./dev.db"

JWT_SECRET="ganti_dengan_string_acak_panjang_dan_rahasia_minimal_32_karakter"

# AI Configuration (Gemini)
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
AI_BATAS_HARIAN=30
AI_BATAS_OBROL=40

# Initial Seed
SEED_ADMIN_EMAIL="admin@discere.local"
